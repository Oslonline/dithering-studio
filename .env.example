NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — required for account deletion (never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=

# Server-only — salt for gallery publish rate-limit IP hashing
GALLERY_RATE_LIMIT_SECRET=

# Feature flags
NEXT_PUBLIC_ENABLE_ACCOUNTS=true
# Enable after applying supabase/migrations/0003_gallery.sql
NEXT_PUBLIC_ENABLE_GALLERY=false
